{
  "name": "breadth-live",
  "displayName": "breadth live",
  "description": "Streams unsaved edits (yours or your coding agent's) to `breadth watch`, so the live canvas updates as code is typed, not only when it is saved.",
  "version": "0.1.0",
  "publisher": "breadth",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/theorjiugovictor/breadth" },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Visualization", "Other"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [{ "command": "breadth.openCanvas", "title": "breadth: Open live canvas" }],
    "configuration": {
      "title": "breadth",
      "properties": {
        "breadth.port": { "type": "number", "default": 4321, "description": "Port of `breadth watch`." },
        "breadth.streamUnsaved": { "type": "boolean", "default": true, "description": "Send unsaved editor contents to `breadth watch` (localhost only)." }
      }
    }
  }
}
