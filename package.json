{
  "name": "breadth-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "schema",
    "collectors",
    "insights",
    "ui",
    "cli"
  ],
  "scripts": {
    "build": "npm run build -w ui && npm run build -w cli",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w ui",
    "breadth": "tsx cli/src/main.ts",
    "demo": "npm run demo:build && node cli/dist/breadth.mjs serve examples/shop/flowgraph.json",
    "demo:build": "node scripts/build-demo.mjs",
    "pages": "node scripts/build-pages.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
