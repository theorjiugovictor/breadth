{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breadth.io/schema/flowgraph/1.0.json",
  "title": "Breadth flowgraph",
  "description": "Universal graph contract. Collectors produce it, the UI only reads it.",
  "type": "object",
  "required": [
    "version",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "description": "Which collectors contributed to this graph (appended on merge).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "executions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/execution"
      }
    },
    "insights": {
      "type": "array",
      "description": "Findings computed over the graph (by breadth rules or other tools). Signals, not verdicts.",
      "items": {
        "$ref": "#/$defs/insight"
      }
    },
    "diff": {
      "type": "object",
      "description": "Present when the graph shows what changed between two versions (written by `breadth diff`). Removed nodes and edges are kept, marked with metadata.diff = \"removed\".",
      "required": [
        "added",
        "removed",
        "changed",
        "edgesAdded",
        "edgesRemoved",
        "changes"
      ],
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "string",
          "description": "The version compared against, e.g. a git ref."
        },
        "head": {
          "type": "string"
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "edgesAdded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "edgesRemoved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "insightsAdded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "insightsResolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "intent": {
          "type": "object",
          "description": "The change checked against what it was asked to do (breadth diff --intent, with an LLM).",
          "required": [
            "request"
          ],
          "additionalProperties": false,
          "properties": {
            "request": {
              "type": "string",
              "description": "What was asked: the PR description or the agent's task."
            },
            "summary": {
              "type": "string",
              "description": "One sentence: does the change do what was asked, and what else."
            },
            "matches": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "description": "Indexes into changes that do what was asked."
            },
            "unrequested": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "change"
                ],
                "additionalProperties": false,
                "properties": {
                  "change": {
                    "type": "integer"
                  },
                  "why": {
                    "type": "string"
                  }
                }
              },
              "description": "Changes nothing in the request explains."
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Things asked for that no change shows."
            },
            "model": {
              "type": "string"
            }
          }
        },
        "changes": {
          "type": "array",
          "description": "Behaviour-level changes, most important first.",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "severity",
              "text",
              "nodes"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string"
              },
              "severity": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "text": {
                "type": "string"
              },
              "nodes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "usedBy": {
                "type": "array",
                "description": "Code in other repositories of the workspace that depends on what changed.",
                "items": {
                  "type": "object",
                  "required": ["repo", "node", "name"],
                  "additionalProperties": false,
                  "properties": {
                    "repo": { "type": "string" },
                    "node": { "type": "string" },
                    "name": { "type": "string" },
                    "file": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "spec": {
          "type": "object",
          "description": "The change checked against the spec change it implements (OpenSpec change, Spec Kit feature, Kiro spec). Absent in repositories without specs.",
          "additionalProperties": false,
          "properties": {
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "title",
                  "reasons"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "format": {
                    "type": "string"
                  },
                  "reasons": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "tasks": {
                    "type": "object",
                    "properties": {
                      "done": {
                        "type": "integer"
                      },
                      "total": {
                        "type": "integer"
                      }
                    }
                  },
                  "requirements": {
                    "type": "object",
                    "properties": {
                      "total": {
                        "type": "integer"
                      },
                      "implemented": {
                        "type": "integer"
                      },
                      "newlyImplemented": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "missing": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "questions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "complete": {
                    "type": "boolean"
                  }
                }
              }
            },
            "outOfScope": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "description": "Indexes into changes that fall outside everything the spec change says it touches."
            },
            "scoped": {
              "type": "boolean"
            },
            "noChange": {
              "type": "boolean",
              "description": "The repository keeps specs but no spec change matches this pull request."
            }
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Profiles whose node roles and edge relations the graph uses, e.g. 'resilience-v1'."
    }
  },
  "$defs": {
    "id": {
      "description": "Stable, deterministic id. Convention '<namespace>:<path>', e.g. 'code:py:src/users.py#get_user', 'svc:checkout', 'tf:aws_s3_bucket.assets', 'k8s:default/Deployment/api'. Same entity => same id across runs and collectors.",
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "collector"
      ],
      "additionalProperties": false,
      "properties": {
        "collector": {
          "type": "string"
        },
        "collectorVersion": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "collectedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "nodeKind": {
      "enum": [
        "function",
        "module",
        "service",
        "datastore",
        "queue",
        "external_api",
        "network_endpoint",
        "infra_resource",
        "pipeline",
        "team",
        "system",
        "org",
        "artifact"
      ]
    },
    "layer": {
      "enum": [
        "code",
        "runtime",
        "network",
        "messaging",
        "infra",
        "delivery",
        "org",
        "resilience"
      ]
    },
    "edgeKind": {
      "enum": [
        "call",
        "data",
        "network",
        "event",
        "read",
        "write",
        "deploy",
        "depends_on"
      ]
    },
    "port": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "description": "Free-form type label: 'str', 'Promise<User>', 'http', 'kafka:orders', 'tcp/5432'."
        },
        "description": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        },
        "default": {
          "type": "string",
          "description": "Default value as source text, if any."
        }
      }
    },
    "sourceRef": {
      "description": "Where the node comes from: a file location, or an external resource reference.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "file": {
          "type": "string",
          "description": "Path relative to the scanned root, forward slashes."
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "resource_ref": {
          "type": "string",
          "description": "e.g. 'aws_s3_bucket.assets', 'apps/v1/Deployment default/api', ARN, URL."
        },
        "url": {
          "type": "string",
          "description": "Optional deep link (repo browser, console)."
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Free-form key/value. Values may be any JSON.",
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "layer"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/nodeKind"
        },
        "layer": {
          "$ref": "#/$defs/layer"
        },
        "parent": {
          "$ref": "#/$defs/id",
          "description": "Containing node id. Drives drill-down (org > system > service > module > function)."
        },
        "aliases": {
          "description": "Other ids/keys that refer to the same entity (e.g. OTel 'service.name=checkout', 'code.function=app.users.get_user'). Merge unifies nodes whose id or aliases collide, and edges may point at an alias.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "source": {
          "$ref": "#/$defs/sourceRef"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "role": {
          "type": "string",
          "description": "What an 'artifact' node is, in its profile: capability, requirement, scenario, change, test, experiment, evidence, approval, snapshot, run (resilience-v1)."
        }
      }
    },
    "endpoint": {
      "type": "object",
      "required": [
        "node"
      ],
      "additionalProperties": false,
      "properties": {
        "node": {
          "$ref": "#/$defs/id"
        },
        "port": {
          "type": "string",
          "description": "Port name on that node. Omitted = the node's default port."
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "description": "Observed payload, any JSON. Collectors must redact/truncate large values."
        },
        "observedAt": {
          "type": "number",
          "description": "Epoch milliseconds."
        },
        "execution": {
          "$ref": "#/$defs/id",
          "description": "Execution this sample came from, if any."
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "Stable id, default '<kind>:<from.node>[.port]-><to.node>[.port]'."
        },
        "from": {
          "$ref": "#/$defs/endpoint"
        },
        "to": {
          "$ref": "#/$defs/endpoint"
        },
        "kind": {
          "$ref": "#/$defs/edgeKind"
        },
        "protocol": {
          "type": "string",
          "description": "http, grpc, tcp, udp, kafka, sqs, sql, redis, ..."
        },
        "label": {
          "type": "string",
          "description": "Short text on the edge, e.g. 'GET /users/{id}', 'topic orders'."
        },
        "loop": {
          "type": "boolean",
          "description": "Happens inside a loop (rendered with a repeat marker)."
        },
        "conditional": {
          "type": "boolean",
          "description": "Happens only on some branch."
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Observed frequency (call sites, spans, flows)."
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sample"
          }
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "relation": {
          "type": "string",
          "description": "Semantic relation (never traffic), from a profile. resilience-v1: implements, verifies, targets, deployed_as, built_from, has_scenario, contains, approves, supports, contradicts, associated_with, stored_in. Such edges use kind 'depends_on' so rules and layout that read kinds are unaffected."
        }
      }
    },
    "status": {
      "enum": [
        "ok",
        "error",
        "unset"
      ]
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "node"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "node": {
          "$ref": "#/$defs/id"
        },
        "parent": {
          "type": "string",
          "description": "Calling step id (span parent)."
        },
        "via": {
          "$ref": "#/$defs/id",
          "description": "Edge id traversed to reach this step, if known."
        },
        "input": {
          "description": "Any JSON."
        },
        "output": {
          "description": "Any JSON."
        },
        "start": {
          "type": "number",
          "description": "Epoch milliseconds (fractional allowed)."
        },
        "end": {
          "type": "number",
          "description": "Epoch milliseconds (fractional allowed)."
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "error": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "id",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "e.g. 'otel:<traceId>'."
        },
        "name": {
          "type": "string"
        },
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "description": "Ordered by start time."
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "insight": {
      "type": "object",
      "required": [
        "id",
        "rule",
        "title",
        "severity",
        "nodes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable id: '<rule>:<subject>'."
        },
        "rule": {
          "type": "string",
          "description": "Rule id, e.g. 'n-plus-one'."
        },
        "category": {
          "enum": [
            "inefficiency",
            "redundancy",
            "risk"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "How likely the signal is real (e.g. public functions may be used outside the repo)."
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "Nodes to highlight; the first is the subject."
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "execution": {
          "$ref": "#/$defs/id",
          "description": "Execution the finding was observed in."
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Step ids within that execution."
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    }
  }
}
